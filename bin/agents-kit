def cmd_reference(args):
    ref_dir = KIT_DIR / "references"
    if not ref_dir.exists():
        print("❌ No references directory found.")
        return

    files = list(ref_dir.glob("**/*.md"))
    if not args.topic:
        print("\n📚 AVAILABLE REFERENCE GUIDES & CHEAT SHEETS")
        print("=" * 65)
        for f in sorted(files):
            rel = f.relative_to(ref_dir)
            title = ""
            for line in f.read_text(encoding="utf-8", errors="ignore").splitlines()[:5]:
                if line.startswith("# "):
                    title = line.replace("# ", "").strip()
                    break
            print(f"  • {str(rel):<42} : {title}")
        print("\n💡 Usage: agents-kit reference <topic_or_filename>\n")
    else:
        topic = args.topic.lower()
        matched = [f for f in files if topic in f.stem.lower() or topic in f.name.lower()]
        if not matched:
            print(f"❌ No reference matching '{args.topic}' found.")
            return
        target = matched[0]
        print(f"\n📖 Viewing Reference: {target.name}\n" + "=" * 65)
        print(target.read_text(encoding="utf-8", errors="ignore")[:2500])
        print()

def cmd_export_skills_json(args):
    import json
    out_path = Path(args.output).resolve() if args.output else KIT_DIR / "skills.json"
    registry = SkillRegistry(KIT_DIR)
    registry.load_catalog()

    skills_list = [
        {
            "name": s.name,
            "description": s.description,
            "category": s.category,
            "path": s.rel_path
        }
        for s in registry.list_all()
    ]

    manifest = {
        "$schema": "https://raw.githubusercontent.com/vercel-labs/skills/main/schema.json",
        "name": "agents-kit",
        "version": "4.3.0",
        "description": "Universal multi-stack engineering suite with 285 production skills, 22 subagents, CLI tools, MCP servers, and workflows.",
        "author": "Hien",
        "repository": "https://github.com/hienpham0344/Agent-kit",
        "total_skills": len(skills_list),
        "skills": skills_list
    }
    with open(out_path, 'w', encoding='utf-8') as f:
        json.dump(manifest, f, indent=2, ensure_ascii=False)
    print(f"✅ Exported {len(skills_list)} skills to universal manifest: {out_path}")

def cmd_add(args):
    """Import skills with security validation and path bounds checking."""
    import tempfile
    source = args.source.strip()
    target_project = Path(args.target).resolve()

    if source.startswith("https://") or source.startswith("git@"):
        clone_url = source
    elif "/" in source and not os.path.exists(source):
        clone_url = f"https://github.com/{source}.git"
    elif os.path.exists(source):
        clone_url = None
    else:
        clone_url = f"https://github.com/{source}.git"

    temp_dir = tempfile.mkdtemp(prefix="agents_kit_add_")
    try:
        if clone_url:
            code = safe_run_subprocess(["git", "clone", "--depth", "1", clone_url, temp_dir])
            if code != 0:
                print(f"❌ Failed to clone repository: {clone_url}")
                sys.exit(code)
            src_root = Path(temp_dir)
        else:
            src_root = Path(source).resolve()

        dest_skills_dir = target_project / ".agents" / "skills"
        dest_skills_dir.mkdir(parents=True, exist_ok=True)

        added = []
        for sm in src_root.glob("**/SKILL.md"):
            if any(p in sm.parts for p in ("node_modules", ".git", ".venv")):
                continue
            folder_name = sm.parent.name
            try:
                safe_name = validate_skill_name(folder_name)
            except ValueError as e:
                print(f"⚠️ Skipping unsafe skill '{folder_name}': {e}")
                continue

            target_folder = dest_skills_dir / safe_name
            validate_safe_destination(dest_skills_dir, target_folder)

            if target_folder.exists():
                if not args.force:
                    print(f"⚠️ Skill '{safe_name}' already exists in target. Use --force to overwrite.")
                    continue
                shutil.rmtree(target_folder)

            shutil.copytree(sm.parent, target_folder, dirs_exist_ok=True)
            added.append(safe_name)

        print(f"\n✅ Imported {len(added)} safe skill(s) into: {dest_skills_dir}")
        for s in added:
            print(f"   • {s}")
    finally:
        shutil.rmtree(temp_dir, ignore_errors=True)

def main():
    parser = argparse.ArgumentParser(prog="agents-kit", description="Universal AI Agent Kit Manager")
    subparsers = parser.add_subparsers(dest="command", required=True)

    subparsers.add_parser("list", help="List all curated skills, agents, and workflows")
    subparsers.add_parser("doctor", help="Run system diagnostics and verify environment")

    # install
    p_inst = subparsers.add_parser("install", help="Install skills and agents into target project")
    p_inst.add_argument("target", help="Target project root directory")
    p_inst.add_argument("--preset", choices=list(PRESETS.keys()) + ["auto"], default="auto", help="Installation preset")
    p_inst.add_argument("--host", choices=list(HOST_ADAPTERS.keys()) + ["all"], default="antigravity", help="Target AI host environment")
    p_inst.add_argument("--copy", action="store_true", help="Copy skills instead of creating symlinks")
    p_inst.add_argument("--dry-run", action="store_true", help="Show planned operations without modifying files")
    p_inst.add_argument("--force", action="store_true", help="Force overwrite on file conflicts")
    p_inst.add_argument("--backup", action="store_true", help="Backup conflicting files before updating")

    # sync
    p_sync = subparsers.add_parser("sync", help="Synchronize an existing project with latest updates")
    p_sync.add_argument("target", nargs="?", default=".", help="Target project root directory")
    p_sync.add_argument("--dry-run", action="store_true", help="Show planned sync without modifying files")
    p_sync.add_argument("--force", action="store_true", help="Force overwrite on file conflicts")
    p_sync.add_argument("--backup", action="store_true", default=True, help="Backup conflicting files")

    # recommend
    p_rec = subparsers.add_parser("recommend", help="Recommend best skills for a user task")
    p_rec.add_argument("task", help="Task description (e.g., 'Debug Spring Boot authentication')")
    p_rec.add_argument("--project", default=".", help="Target project root for stack context")
    p_rec.add_argument("--top", type=int, default=5, help="Number of recommendations")
    p_rec.add_argument("--explain", action="store_true", help="Explain why each skill was chosen")
    p_rec.add_argument("--json", action="store_true", help="Output recommendation in JSON format")

    # plan
    p_plan = subparsers.add_parser("plan", help="Decompose high-level task into orchestration plan")
    p_plan.add_argument("task", help="Task description")
    p_plan.add_argument("--project", default=".", help="Target project root for stack context")
    p_plan.add_argument("--json", action="store_true", help="Output plan in JSON format")

    # agents
    p_ag = subparsers.add_parser("agents", help="Inspect and validate subagent profiles")
    p_ag.add_argument("action", nargs="?", default="list", choices=["list", "validate"], help="Agent action")

    # audit
    p_audit = subparsers.add_parser("audit", help="Audit existing repository configuration")
    p_audit.add_argument("target", nargs="?", default=".", help="Target project root directory")

    # setup-env
    subparsers.add_parser("setup-env", help="Add agents-kit to your ~/.bashrc for global CLI access")

    # search
    p_search = subparsers.add_parser("search", help="Search skills and descriptions by keyword")
    p_search.add_argument("query", help="Keyword or topic to search")

    # create-skill
    p_cskill = subparsers.add_parser("create-skill", help="Scaffold a new skill")
    p_cskill.add_argument("name", help="Kebab-case skill name")
    p_cskill.add_argument("--domain", default="engineering-core", help="Target domain")
    p_cskill.add_argument("--description", default="", help="Skill description")

    # mcp
    p_mcp = subparsers.add_parser("mcp", help="Manage and verify MCP servers")
    p_mcp.add_argument("action", nargs="?", default="list", choices=["list", "doctor", "verify"], help="MCP action")
    p_mcp.add_argument("name", nargs="?", default="", help="Server name for verify")

    # test
    subparsers.add_parser("test", help="Run automated test suite")

    # reference
    p_ref = subparsers.add_parser("reference", help="View reference guides, cheat sheets, and cookbooks")
    p_ref.add_argument("topic", nargs="?", default="", help="Topic keyword or filename")

    # export-skills-json
    p_exp = subparsers.add_parser("export-skills-json", help="Export universal skills.json manifest for Vercel/Anthropic")
    p_exp.add_argument("-o", "--output", help="Output path for skills.json")

    # add
    p_add = subparsers.add_parser(
        "add",
        help="Import skills from a GitHub repository or community source",
        description="Import skills from a GitHub repository or community source"
    )
    p_add.add_argument("source", help="GitHub repo or Git URL")
    p_add.add_argument("--target", default=".", help="Target project root directory")
    p_add.add_argument("--skill", default="", help="Specific skill name to import")
    p_add.add_argument("--force", action="store_true", help="Overwrite existing destination skill")

    args = parser.parse_args()
    cmd_map = {
        "list": cmd_list,
        "doctor": cmd_doctor,
        "install": cmd_install,
        "sync": cmd_sync,
        "recommend": cmd_recommend,
        "plan": cmd_plan,
        "agents": cmd_agents,
        "audit": cmd_audit,
        "setup-env": cmd_setup_env,
        "search": cmd_search,
        "create-skill": cmd_create_skill,
        "mcp": cmd_mcp,
        "test": cmd_test,
        "reference": cmd_reference,
        "export-skills-json": cmd_export_skills_json,
        "add": cmd_add,
    }

    cmd_map[args.command](args)

if __name__ == "__main__":
    main()
