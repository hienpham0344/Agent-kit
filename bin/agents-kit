import os
import sys
import argparse
import shutil
import glob
from pathlib import Path

# Add project root to sys.path
KIT_DIR = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(KIT_DIR))

from core.presets import PRESETS, PRESET_DESCRIPTIONS
from core.detection import detect_project_stack
from core.planner import InstallationPlanner
from core.manifest import ManifestManager
from core.registry import SkillRegistry
from core.routing import SkillRouter
from core.agent_router import AgentRouter
from core.orchestration import OrchestrationEngine
from core.hosts.adapters import get_adapter, HOST_ADAPTERS
from core.security import validate_skill_name, validate_safe_destination
from core.cli import safe_run_subprocess

SKILLS_DIR = KIT_DIR / "skills"
AGENTS_DIR = KIT_DIR / "agents"
RULES_DIR = KIT_DIR / "rules"
WORKFLOWS_DIR = KIT_DIR / "workflows"

def cmd_list(args):
    registry = SkillRegistry(KIT_DIR)
    registry.load_catalog()

    print("\n📦 AGENTS-KIT: CURATED SKILLS INVENTORY")
    print("=" * 65)
    skills_by_cat = {}
    for s in registry.list_all():
        skills_by_cat.setdefault(s.category, []).append(s)

    for cat in sorted(skills_by_cat.keys()):
        slist = sorted(skills_by_cat[cat], key=lambda x: x.name)
        print(f"\n📂 [{cat.upper()}] ({len(slist)} skills):")
        for s in slist:
            print(f"  • {s.name:<32} {s.description[:75]}...")

    print("\n" + "=" * 65)
    print(f"Total Curated Skills: {registry.get_total_count()}")

    print("\n🤖 CONFIGURED AGENT PROFILES:")
    profiles = sorted(glob.glob(str(AGENTS_DIR / "profiles" / "*.agent.md")))
    for p in profiles:
        print(f"  • {Path(p).stem}")

    print("\n📋 STANDARD WORKFLOW RECIPES:")
    recipes = sorted(glob.glob(str(WORKFLOWS_DIR / "recipes" / "*.md")))
    for r in recipes:
        print(f"  • {Path(r).stem}")
    print()

def cmd_install(args):
    target = Path(args.target).resolve()
    if not target.exists():
        print(f"❌ Error: Target directory does not exist: {target}")
        sys.exit(1)

    preset = args.preset
    categories = None

    if not preset or preset == "auto":
        detection = detect_project_stack(target)
        print(f"\n🔎 Auto-Detection Result:")
        print(f"   • Recommended Preset : {detection.recommended_preset.upper()}")
        print(f"   • Confidence         : {int(detection.confidence * 100)}%")
        print(f"   • Explanation        : {detection.explanation}")
        if detection.evidence:
            print(f"   • Evidence           : {', '.join(detection.evidence)}")
        preset = detection.recommended_preset
        categories = detection.recommended_categories

    planner = InstallationPlanner(
        kit_dir=KIT_DIR,
        target_dir=target,
        preset=preset,
        copy=args.copy,
        force=args.force,
        backup=args.backup,
        categories=categories
    )

    plan = planner.plan()

    print(f"\n🚀 Agents-kit Installation Plan: {target}")
    print(f"   Preset:     {plan.preset.upper()}")
    print(f"   Categories: {len(plan.categories)} ({', '.join(plan.categories)})")
    print(f"   Mode:       {plan.mode.upper()}")
    print(f"   Operations: {len(plan.operations)} files planned")
    print("-" * 65)

    if plan.has_conflicts and not args.force:
        print("⚠️ File conflicts detected:")
        for op in plan.operations:
            if op.is_conflict:
                print(f"   ❌ {op.dst.name}: {op.details}")
        print("\n💡 Aborted to prevent data loss. Re-run with '--force' to overwrite or '--backup' to keep copies.")
        sys.exit(1)

    if args.dry_run:
        res = planner.execute(plan, dry_run=True)
        print(f"🔍 [DRY RUN] Plan verified successfully without touching disk:")
        print(f"   • To Create    : {res['created']}")
        print(f"   • To Update    : {res['updated']}")
        print(f"   • Unchanged    : {res['unchanged']}")
        print(f"   • Conflicts    : {res['conflicts']}\n")
        return

    try:
        res = planner.execute(plan, dry_run=False)
        print(f"✅ Successfully installed {res['created'] + res['updated']} skills and configs into {target}")
        if res["backed_up"] > 0:
            print(f"📦 Backed up {res['backed_up']} replaced files to .agents/backups/")
        print(f"📄 Installation manifest recorded at: {target}/.agents/agents-kit.manifest.json\n")
    except Exception as e:
        print(f"❌ Installation failed: {e}")
        sys.exit(1)

def cmd_sync(args):
    """Synchronize project while preserving previous preset and copy/symlink mode."""
    target = Path(args.target).resolve()
    manifest_mgr = ManifestManager(target)
    manifest = manifest_mgr.load_manifest()

    if not manifest:
        print(f"⚠️ No agents-kit installation manifest found in {target}. Falling back to 'auto' detection.")
        args.preset = "auto"
        args.copy = False
        args.force = False
        args.backup = True
        args.dry_run = getattr(args, "dry_run", False)
        cmd_install(args)
        return

    print(f"\n🔄 Synchronizing existing project: {target}")
    print(f"   Existing Preset : {manifest.preset.upper()}")
    print(f"   Existing Mode   : {manifest.mode.upper()}")
    print("-" * 65)

    planner = InstallationPlanner(
        kit_dir=KIT_DIR,
        target_dir=target,
        preset=manifest.preset,
        copy=(manifest.mode == "copy"),
        force=getattr(args, "force", False),
        backup=getattr(args, "backup", True),
        categories=manifest.categories
    )

    plan = planner.plan()
    if plan.has_conflicts and not getattr(args, "force", False):
        print("⚠️ File conflicts detected during sync:")
        for op in plan.operations:
            if op.is_conflict:
                print(f"   ❌ {op.dst.name}: {op.details}")
        print("\n💡 Aborted sync to protect custom changes. Run with '--force' to overwrite or inspect manually.")
        sys.exit(1)

    res = planner.execute(plan, dry_run=getattr(args, "dry_run", False))
    print(f"✅ Sync complete! Created: {res['created']}, Updated: {res['updated']}, Unchanged: {res['unchanged']}\n")

def cmd_recommend(args):
    """Recommend best skills for a specific user task description."""
    import json
    router = SkillRouter(KIT_DIR)
    target = Path(args.project).resolve() if args.project else None
    res = router.recommend(args.task, target_dir=target, top_k=args.top)

    if getattr(args, "json", False):
        print(json.dumps(res.to_dict(), indent=2, ensure_ascii=False))
        return

    print(f"\n🎯 INTELLIGENT SKILL RECOMMENDATIONS")
    print("=" * 65)
    print(f"Task: \"{args.task}\"")
    print(f"Decision: {res.decision.upper()}")
    if res.intent_analysis:
        print(f"Intents: {res.intent_analysis.primary_intent} {res.intent_analysis.secondary_intents}")
    if res.project_context and res.project_context.detected_languages:
        print(f"Project Context: {', '.join(res.project_context.detected_languages)}")
    print("-" * 65)

    if not res.recommendations:
        print("No high-confidence skills matched this task.")
        if res.warnings:
            for w in res.warnings:
                print(f"💡 {w}")
        return

    for idx, rec in enumerate(res.recommendations, 1):
        s = rec.skill
        print(f"{idx}. [{s.category}] {s.name} (Relevance Score: {rec.score:.1f})")
        print(f"   {s.description[:85]}...")
        if args.explain:
            print(f"   💡 Rationale : {'; '.join(rec.reasons)}")
            if rec.resolved_dependencies:
                print(f"   🔗 Dependencies: {', '.join(rec.resolved_dependencies)}")
            print(f"   📂 Location  : {s.rel_path}")
        print()

    if res.conflicts:
        print("⚠️ Routing Guidance & Conflicts:")
        for c in res.conflicts:
            print(f"   • {c}")
        print()

def cmd_plan(args):
    """Decompose high-level task into a dependency-aware orchestration plan with agent delegation."""
    import json
    router = SkillRouter(KIT_DIR)
    agent_router = AgentRouter(KIT_DIR)
    engine = OrchestrationEngine(KIT_DIR)

    target = Path(args.project).resolve() if args.project else None
    s_res = router.recommend(args.task, target_dir=target, top_k=3)
    selected_skill_names = [r.skill.name for r in s_res.recommendations]

    a_res = agent_router.route_agent(
        args.task,
        s_res.intent_analysis,
        selected_skill_names,
        s_res.project_context
    )

    primary_agent = a_res.primary_agent.id if a_res.primary_agent else "main_agent"
    secondary_agent = a_res.secondary_agent.id if a_res.secondary_agent else None

    plan = engine.decompose_task(
        args.task,
        primary_agent=primary_agent,
        secondary_agent=secondary_agent,
        selected_skills=selected_skill_names
    )

    if getattr(args, "json", False):
        out = {
            "orchestration_plan": plan.to_dict(),
            "agent_routing": a_res.to_dict(),
            "skill_recommendations": s_res.to_dict()
        }
        print(json.dumps(out, indent=2, ensure_ascii=False))
        return

    print(f"\n📋 AGENT-KIT ORCHESTRATION PLAN")
    print("=" * 65)
    print(f"Task: \"{args.task}\"")
    print(f"Delegation Policy: {a_res.delegation_policy.upper()}")
    print(f"Assigned Primary : {primary_agent}")
    if secondary_agent:
        print(f"Assigned Reviewer: {secondary_agent}")
    print(f"Rationale        : {'; '.join(a_res.reasons)}")
    print("-" * 65)
    print("Execution Workstreams:")
    for step in plan.steps:
        deps = f" [Depends on: {', '.join(step.dependencies)}]" if step.dependencies else " [Independent]"
        print(f"  • {step.id:<22} : {step.title}")
        print(f"    Actor: {step.assigned_agent:<18} Skills: {', '.join(step.required_skills)}")
        if step.verification_command:
            print(f"    Verification Gate: {step.verification_command}")
    print("=" * 65)
    print("💡 Note: Run steps natively in your AI coding environment.\n")

def cmd_agents(args):
    """Inspect and validate configured subagent profiles."""
    agent_router = AgentRouter(KIT_DIR)
    agents = agent_router.agent_registry.list_all()

    if args.action == "list":
        print(f"\n🤖 CONFIGURED SUBAGENTS ({len(agents)} profiles)")
        print("=" * 65)
        for a in sorted(agents, key=lambda x: x.id):
            status = "✅ READY" if a.is_ready else f"⚠️ MISSING SKILLS ({', '.join(a.missing_skills)})"
            print(f"  • {a.id:<24} : {a.role}")
            print(f"    Status: {status}")
            print(f"    Skills ({len(a.skills)}): {', '.join(a.skills[:4])}...")
        print()
    elif args.action == "validate":
        print(f"\n🔍 VALIDATING AGENT PROFILES & SKILL READINESS")
        print("=" * 65)
        ready_count = sum(1 for a in agents if a.is_ready)
        print(f"Total Agents Checked : {len(agents)}")
        print(f"Ready for Invocation : {ready_count}")
        print(f"Missing Dependencies : {len(agents) - ready_count}")
        print("=" * 65)
        if ready_count == len(agents):
            print("🎉 ALL 22 SUBAGENTS ARE FULLY COMPATIBLE & READY!\n")
        else:
            for a in agents:
                if not a.is_ready:
                    print(f"  ❌ {a.id}: missing skills {a.missing_skills}")
            print()

def cmd_audit(args):
    target = Path(args.target).resolve()
    print(f"\n🔍 Auditing Agents Configuration in: {target}")
    print("-" * 65)

    manifest_mgr = ManifestManager(target)
    manifest = manifest_mgr.load_manifest()

    if manifest:
        print(f"📋 Managed Manifest : PRESENT (Preset: {manifest.preset}, Mode: {manifest.mode})")
        print(f"   • Recorded Skills: {len(manifest.installed_skills)}")
        print(f"   • Managed Files  : {len(manifest.managed_files)}")
    else:
        print("📋 Managed Manifest : UNMANAGED (No agents-kit manifest found)")

    skills_dir = target / ".agents" / "skills"
    if skills_dir.exists():
        skills = list(skills_dir.iterdir())
        broken = [s for s in skills if s.is_symlink() and not s.resolve().exists()]
        print(f"📁 .agents/skills/  : {len(skills)} installed skills")
        print(f"   • Broken symlinks: {len(broken)}")
        for b in broken[:5]:
            print(f"     ❌ Broken: {b.name} -> {os.readlink(b)}")
    else:
        print("📁 .agents/skills/  : MISSING")

    for f_name in ("AGENTS.md", ".cursorrules", ".github/copilot-instructions.md"):
        p = target / f_name
        status = "EXISTS" if p.exists() else "MISSING"
        print(f"📄 {f_name:<20} : {status}")
    print("-" * 65 + "\n")

def cmd_doctor(args):
    print("\n🩺 AGENTS-KIT SYSTEM & ENVIRONMENT HEALTH CHECK")
    print("=" * 65)

    tools = {
        "Git": "git",
        "Python 3": "python3",
        "Node.js": "node",
        "Context Mode (MCP)": "context-mode",
        "Docker": "docker"
    }
    for name, cmd in tools.items():
        loc = shutil.which(cmd)
        status = f"✅ INSTALLED ({loc})" if loc else "⚠️ NOT FOUND (Optional/Recommended)"
        print(f"  • {name:<22}: {status}")

    print("\n🔍 Internal Kit Integrity:")
    registry = SkillRegistry(KIT_DIR)
    registry.load_catalog()
    skill_count = registry.get_total_count()
    agent_count = len(list((AGENTS_DIR / "profiles").glob("*.agent.md")))
    recipe_count = len(list((WORKFLOWS_DIR / "recipes").glob("*.md")))
    template_count = len([t for t in (WORKFLOWS_DIR / "templates").iterdir() if t.is_file()])
    ref_count = len(list((KIT_DIR / "references").glob("**/*.md")))

    print(f"  • Total Skills Available    : {skill_count} (Expected: 285)")
    print(f"  • Configured Subagents     : {agent_count} (Expected: 22)")
    print(f"  • Workflow Recipes         : {recipe_count} (Expected: 10)")
    print(f"  • Production Templates     : {template_count} (Expected: 18)")
    print(f"  • Reference Guides         : {ref_count} (Expected: 6)")

    if skill_count >= 285 and agent_count == 22 and recipe_count >= 10:
        print("\n🎉 Agents-kit status: 100% HEALTHY & READY TO USE!\n")
    else:
        print("\n⚠️ Agents-kit status: Some components missing.\n")

def cmd_setup_env(args):
    bashrc = Path.home() / ".bashrc"
    bin_path = str(KIT_DIR / "bin")
    export_line = f'export PATH="{bin_path}:$PATH"'

    if not bashrc.exists():
        print(f"❌ Error: {bashrc} not found.")
        return

    content = bashrc.read_text(encoding="utf-8", errors="ignore")
    if bin_path in content:
        print(f"✅ Agents-kit binary path is already in {bashrc}!")
    else:
        with open(bashrc, "a", encoding="utf-8") as f:
            f.write(f"\n# Agents-kit CLI path\n{export_line}\n")
        print(f"🎉 Successfully added Agents-kit to {bashrc}!")
        print("💡 Run 'source ~/.bashrc' to use 'agents-kit' directly from anywhere!")

def cmd_search(args):
    router = SkillRouter(KIT_DIR)
    res = router.recommend(args.query, top_k=15, min_score=1.0)
